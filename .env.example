# Copie este arquivo para .env e preencha com suas credenciais.
# O .env está no .gitignore e não deve ser commitado.

# Supabase Storage (API compatível com S3)
# Painel do Supabase > Project Settings > Storage > S3 Connection
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
AWS_DEFAULT_REGION=sa-east-1
AWS_ACCESS_KEY_ID=<sua-access-key-id>
AWS_SECRET_ACCESS_KEY=<sua-secret-access-key>
